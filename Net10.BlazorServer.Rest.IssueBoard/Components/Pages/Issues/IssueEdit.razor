@page "/issues/{Id:int}/edit"
@inject IssueService IssueService
@inject NavigationManager Navigation

<PageTitle>課題内容編集</PageTitle>

<h3>課題内容編集</h3>

@if (_isLoading)
{
    <p>読み込み中...</p>
}
else if (_issue is null || _model is null)
{
    <div class="alert alert-danger">課題が見つかりません。</div>
    <button class="btn btn-secondary" @onclick="NavigateToList">一覧へ戻る</button>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="mb-3 row">
            <label class="col-sm-3 col-form-label">記入者氏名</label>
            <div class="col-sm-9">
                <input class="form-control" value="@_issue.AuthorName" readonly />
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-3 col-form-label">登録日時</label>
            <div class="col-sm-9">
                <input class="form-control" value="@_issue.CreatedAt.ToString("yyyy/MM/dd HH:mm")" readonly />
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-3 col-form-label">カテゴリ名</label>
            <div class="col-sm-9">
                <InputText class="form-control" @bind-Value="_model.Category" />
                <ValidationMessage For="() => _model.Category" />
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-3 col-form-label">課題タイトル <span class="text-danger">*</span></label>
            <div class="col-sm-9">
                <InputText class="form-control" @bind-Value="_model.Title" />
                <ValidationMessage For="() => _model.Title" />
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-3 col-form-label">課題の文面 <span class="text-danger">*</span></label>
            <div class="col-sm-9">
                <InputTextArea class="form-control" rows="5" @bind-Value="_model.Description" />
                <ValidationMessage For="() => _model.Description" />
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-3 col-form-label">現在の状況 <span class="text-danger">*</span></label>
            <div class="col-sm-9">
                <InputSelect class="form-select" @bind-Value="_model.Status">
                    @foreach (IssueStatus status in Enum.GetValues<IssueStatus>())
                    {
                        <option value="@status">@status.ToDisplayName()</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-3 col-form-label">解決の文面</label>
            <div class="col-sm-9">
                <InputTextArea class="form-control" rows="5" @bind-Value="_model.Resolution" />
                <ValidationMessage For="() => _model.Resolution" />
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-3 col-form-label">解決担当者名</label>
            <div class="col-sm-9">
                <InputText class="form-control" @bind-Value="_model.ResolverName" />
                <ValidationMessage For="() => _model.ResolverName" />
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-3 col-form-label">最終結果日時</label>
            <div class="col-sm-9">
                <input class="form-control" value="@(_issue.ResolvedAt?.ToString("yyyy/MM/dd HH:mm") ?? "")" readonly />
                <div class="form-text">更新時に現在日時が自動設定されます。</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        <div class="mt-3">
            <button type="submit" class="btn btn-primary me-2">更新</button>
            <button type="button" class="btn btn-secondary" @onclick="NavigateToDetail">戻る</button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private IssueDto? _issue;
    private UpdateIssueDto? _model;
    private bool _isLoading = true;
    private string? _errorMessage;

    private void NavigateToList() => Navigation.NavigateTo("/issues");
    private void NavigateToDetail() => Navigation.NavigateTo($"/issues/{Id}");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _issue = await IssueService.GetIssueAsync(Id);
            if (_issue is not null)
            {
                _model = new UpdateIssueDto
                {
                    Category = _issue.Category,
                    Title = _issue.Title,
                    Description = _issue.Description,
                    Status = _issue.Status,
                    Resolution = _issue.Resolution,
                    ResolverName = _issue.ResolverName
                };
            }
        }
        catch
        {
            _errorMessage = "データの取得中にエラーが発生しました。";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        try
        {
            await IssueService.UpdateIssueAsync(Id, _model!);
            NavigateToDetail();
        }
        catch
        {
            _errorMessage = "更新中にエラーが発生しました。";
        }
    }
}
