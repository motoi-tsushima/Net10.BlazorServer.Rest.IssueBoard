@page "/issues/{Id:int}"
@inject IssueService IssueService
@inject NavigationManager Navigation

<PageTitle>課題内容表示</PageTitle>

<h3>課題内容表示</h3>

@if (_isLoading)
{
    <p>読み込み中...</p>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
    <button class="btn btn-secondary" @onclick="NavigateToList">戻る</button>
}
else if (_issue is not null)
{
    <dl class="row">
        <dt class="col-sm-3">記入者氏名</dt>
        <dd class="col-sm-9">@_issue.AuthorName</dd>

        <dt class="col-sm-3">登録日時</dt>
        <dd class="col-sm-9">@_issue.CreatedAt.ToString("yyyy/MM/dd HH:mm:ss")</dd>

        <dt class="col-sm-3">カテゴリ名</dt>
        <dd class="col-sm-9">@(_issue.Category ?? "-")</dd>

        <dt class="col-sm-3">課題タイトル</dt>
        <dd class="col-sm-9">@_issue.Title</dd>

        <dt class="col-sm-3">課題の文面</dt>
        <dd class="col-sm-9" style="white-space:pre-wrap">@_issue.Description</dd>

        <dt class="col-sm-3">現在の状況</dt>
        <dd class="col-sm-9">@_issue.Status.ToDisplayName()</dd>

        <dt class="col-sm-3">解決の文面</dt>
        <dd class="col-sm-9" style="white-space:pre-wrap">@_issue.Resolution</dd>

        <dt class="col-sm-3">解決担当者名</dt>
        <dd class="col-sm-9">@_issue.ResolverName</dd>

        <dt class="col-sm-3">最終結果日時</dt>
        <dd class="col-sm-9">@_issue.ResolvedAt?.ToString("yyyy/MM/dd HH:mm:ss")</dd>
    </dl>

    <div class="mt-3">
        <button class="btn btn-primary me-2" @onclick="NavigateToEdit">編集</button>
        <button class="btn btn-danger me-2" @onclick="NavigateToDelete">削除</button>
        <button class="btn btn-secondary" @onclick="NavigateToList">戻る</button>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private IssueDto? _issue;
    private bool _isLoading = true;
    private string? _errorMessage;

    private void NavigateToList() => Navigation.NavigateTo("/issues");
    private void NavigateToEdit() => Navigation.NavigateTo($"/issues/{Id}/edit");
    private void NavigateToDelete() => Navigation.NavigateTo($"/issues/{Id}/delete");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _issue = await IssueService.GetIssueAsync(Id);
            if (_issue is null)
                _errorMessage = "課題が見つかりません。";
        }
        catch
        {
            _errorMessage = "データの取得中にエラーが発生しました。";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
